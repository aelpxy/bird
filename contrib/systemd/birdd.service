# Rootless user unit for birdd.
#
# Install:
#   install -Dm755 target/release/birdd target/release/bird -t ~/.local/bin
#   install -Dm644 contrib/systemd/birdd.service -t ~/.config/systemd/user
#   systemctl --user daemon-reload
#   systemctl --user enable --now podman.socket birdd
#   loginctl enable-linger "$USER"   # start at boot without a login session
#
# birdd listens on ports 80 and 443; let unprivileged users bind them (once, as root):
#   echo net.ipv4.ip_unprivileged_port_start=80 > /etc/sysctl.d/90-bird.conf && sysctl --system

[Unit]
Description=bird daemon (API, proxy and machine supervisor)
Wants=podman.socket
After=podman.socket

[Service]
Type=exec
ExecStart=%h/.local/bin/birdd
Environment=RUST_LOG=info
# every proxied request holds two sockets; the default soft limit of 1024 starves clients under load
LimitNOFILE=524288
Restart=on-failure
RestartSec=2
TimeoutStopSec=45

[Install]
WantedBy=default.target
