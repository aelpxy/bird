{
  "openapi": "3.1.0",
  "info": {
    "title": "bird",
    "description": "Deploy and run containers on a bird server. Browse these docs at /docs. Every endpoint except the docs needs the API token from birdd's data directory as a bearer token.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/deploy": {
      "post": {
        "tags": [
          "deployments"
        ],
        "summary": "Deploy an image, creating the service on first deploy",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeployRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Deployed and serving traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeployResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting state or operation in progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The app did not become healthy; includes its last log lines",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "List services",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "Services in the default environment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{name}": {
      "delete": {
        "tags": [
          "services"
        ],
        "summary": "Remove a service and its machines",
        "operationId": "remove",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Service and its machines removed"
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting state or operation in progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{name}/deployments": {
      "get": {
        "tags": [
          "deployments"
        ],
        "summary": "List deployments",
        "operationId": "list",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deployments, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeploymentInfo"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{name}/domains": {
      "get": {
        "tags": [
          "domains"
        ],
        "summary": "List domains of a service",
        "operationId": "list",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Domains routed to the service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "domains"
        ],
        "summary": "Route a domain to a service",
        "operationId": "add",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDomain"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Domain added, returns all domains of the service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting state or operation in progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{name}/domains/{hostname}": {
      "delete": {
        "tags": [
          "domains"
        ],
        "summary": "Stop routing a domain to a service",
        "operationId": "remove",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hostname",
            "in": "path",
            "description": "Domain to remove",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Domain removed"
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{name}/logs": {
      "get": {
        "tags": [
          "logs"
        ],
        "summary": "Read or follow logs",
        "operationId": "logs",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "description": "Number of recent lines per machine, default 100, at most 10000",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "follow",
            "in": "query",
            "description": "Keep the response open and stream new lines as they are written",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent log lines; with follow=true a newline-delimited JSON stream of LogEntry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LogEntry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{name}/rollback": {
      "post": {
        "tags": [
          "deployments"
        ],
        "summary": "Roll back to an earlier deployment",
        "operationId": "rollback",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RollbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Earlier image, port and variables deployed again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeployResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting state or operation in progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The app did not become healthy; includes its last log lines",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{name}/scale": {
      "put": {
        "tags": [
          "services"
        ],
        "summary": "Set the number of machines",
        "operationId": "update",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScaleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Replica count saved, machines converge in the background"
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/services/{name}/variables": {
      "get": {
        "tags": [
          "variables"
        ],
        "summary": "List variable names",
        "operationId": "list",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Variable names; values are never returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "variables"
        ],
        "summary": "Set or unset variables",
        "operationId": "update",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Service name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateVariables"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Variables updated, redeployed unless deploy is false",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VariablesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Service or resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting state or operation in progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The app did not become healthy; includes its last log lines",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDomain": {
        "type": "object",
        "required": [
          "hostname"
        ],
        "properties": {
          "hostname": {
            "$ref": "#/components/schemas/Hostname"
          }
        }
      },
      "DeployRequest": {
        "type": "object",
        "required": [
          "name",
          "image",
          "port"
        ],
        "properties": {
          "domain": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Hostname"
              },
              {
                "type": "null"
              }
            ]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "health": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/HealthCheck"
              },
              {
                "type": "null"
              }
            ]
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "port": {
            "$ref": "#/components/schemas/Port"
          }
        }
      },
      "DeployResponse": {
        "type": "object",
        "required": [
          "service",
          "deployment_id",
          "image",
          "domains"
        ],
        "properties": {
          "deployment_id": {
            "$ref": "#/components/schemas/DeploymentId"
          },
          "domains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hostname"
            }
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "service": {
            "$ref": "#/components/schemas/Name"
          }
        }
      },
      "DeploymentId": {
        "type": "string",
        "format": "uuid"
      },
      "DeploymentInfo": {
        "type": "object",
        "required": [
          "id",
          "image",
          "port",
          "status",
          "variables",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "$ref": "#/components/schemas/DeploymentId"
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "port": {
            "$ref": "#/components/schemas/Port"
          },
          "status": {
            "$ref": "#/components/schemas/DeploymentStatus"
          },
          "variables": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DeploymentStatus": {
        "type": "string",
        "enum": [
          "pending",
          "deploying",
          "active",
          "superseded",
          "failed"
        ]
      },
      "DeploymentSummary": {
        "type": "object",
        "required": [
          "id",
          "status",
          "machines"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DeploymentId"
          },
          "machines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MachineSummary"
            }
          },
          "status": {
            "$ref": "#/components/schemas/DeploymentStatus"
          }
        }
      },
      "EnvKey": {
        "type": "string"
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HealthCheck": {
        "type": "string",
        "enum": [
          "http",
          "tcp"
        ]
      },
      "Hostname": {
        "type": "string"
      },
      "ImageRef": {
        "type": "string"
      },
      "LogEntry": {
        "type": "object",
        "required": [
          "machine",
          "stream",
          "text"
        ],
        "properties": {
          "machine": {
            "$ref": "#/components/schemas/MachineId"
          },
          "stream": {
            "$ref": "#/components/schemas/LogStream"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "LogStream": {
        "type": "string",
        "enum": [
          "stdout",
          "stderr"
        ]
      },
      "MachineId": {
        "type": "string",
        "format": "uuid"
      },
      "MachineState": {
        "type": "string",
        "enum": [
          "created",
          "starting",
          "running",
          "stopping",
          "stopped",
          "failed",
          "destroyed"
        ]
      },
      "MachineSummary": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/MachineId"
          },
          "state": {
            "$ref": "#/components/schemas/MachineState"
          }
        }
      },
      "Name": {
        "type": "string"
      },
      "Port": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "Replicas": {
        "type": "integer",
        "format": "int32",
        "maximum": 32,
        "minimum": 1
      },
      "RollbackRequest": {
        "type": "object",
        "properties": {
          "deployment_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DeploymentId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ScaleRequest": {
        "type": "object",
        "required": [
          "replicas"
        ],
        "properties": {
          "replicas": {
            "$ref": "#/components/schemas/Replicas"
          }
        }
      },
      "ServiceSummary": {
        "type": "object",
        "required": [
          "name",
          "image",
          "port",
          "replicas",
          "health",
          "domains"
        ],
        "properties": {
          "deployment": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DeploymentSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "domains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hostname"
            }
          },
          "health": {
            "$ref": "#/components/schemas/HealthCheck"
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "port": {
